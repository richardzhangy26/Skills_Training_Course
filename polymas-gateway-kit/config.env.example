# polymas-proxy 配置（可选）
#
# 复制成 config.env 后按需修改；命令行参数优先级更高。
# 注意：这里**不需要、也不要填** API key —— 反代只做格式改写，
#      鉴权头由客户端原样透传到网关。

# 反代监听端口（客户端 baseURL 会用到）
POLYMAS_PROXY_PORT=8787
POLYMAS_PROXY_HOST=127.0.0.1

# 上游根地址：请求 /v1/xxx 会被转发到 <上游>/v1/xxx
# 默认是公司的 llm-service 网关；换成别的 OpenAI 兼容网关也行
POLYMAS_PROXY_UPSTREAM=http://llm-service.polymas.com/api/openai

# 安装目录（反代脚本会被拷到这里常驻）
# POLYMAS_PROXY_DIR=$HOME/.polymas-proxy

# 常驻服务标识（macOS launchd label / Linux systemd unit 名）
# POLYMAS_PROXY_LABEL=com.polymas.proxy

# 日志路径
# POLYMAS_PROXY_LOG=$HOME/Library/Logs/polymas-proxy.log

# ---- 调试用（平时别开） ----
# POLYMAS_PROXY_MAX_INT=2147483647      # 数值约束安全上限
# POLYMAS_PROXY_DUMP_DIR=/tmp/polymas-dumps   # 把每个请求体落盘，排查 schema 问题
# POLYMAS_PROXY_DEBUG=1                 # 输出每行 SSE 调试信息
